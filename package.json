{
  "name": "dsh-git-visual",
  "version": "0.2.0",
  "description": "Git graph, diffs, staging, commits and branch switching inside DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-connection"
      ],
      "external": [
        "react"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.9.3",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "yaml": "^2.8.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "prepack": "npm run build"
  },
  "author": "charlesjson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlesjson/dsh-git-visual.git"
  },
  "homepage": "https://github.com/charlesjson/dsh-git-visual#readme",
  "bugs": {
    "url": "https://github.com/charlesjson/dsh-git-visual/issues"
  }
}
